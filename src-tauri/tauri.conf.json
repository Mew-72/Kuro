{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "kuro-dekstop",
  "version": "0.1.0",
  "identifier": "com.mew72.kuro",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kuro",
        "width": 350,
        "height": 500,
        "minWidth": 350,
        "minHeight": 500,
        "maxWidth": 350,
        "maxHeight": 500,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Kuro Settings",
        "url": "/settings",
        "width": 380,
        "height": 600,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
